{
  "manifest_version": 3,
  "name": "Azimut Capture",
  "version": "0.3.4",
  "description": "File into Azimut: screenshot the map you are looking at (coordinates from the URL), save any other page as a bookmark, cite or quote a page into a case note from a side panel, fill a social composer with a thread the app prepared, or open a reverse-image engine with a picture from the case.",
  "permissions": ["activeTab", "scripting", "storage", "notifications", "contextMenus", "sidePanel"],
  "optional_host_permissions": ["<all_urls>"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://bsky.app/*",
    "https://lens.google.com/*",
    "https://www.google.com/*",
    "https://yandex.com/*",
    "https://www.bing.com/*",
    "https://tineye.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["notesmsg.js", "mapsites.js", "postlink.js", "background.js"]
  },
  "action": {
    "default_title": "Azimut: the tools on a map, the case note anywhere else",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "notes.html"
  },
  "sidebar_action": {
    "default_panel": "notes.html",
    "default_title": "Azimut notes",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "open_at_install": false
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Open Azimut on this page: the tools on a map, the case note anywhere else"
    },
    "open-note": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Open the case note beside the page"
    },
    "capture-note": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Capture this map into the note in the side panel"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "azimut-capture@osintmethat.github.io",
      "strict_min_version": "115.0",
      "update_url": "https://raw.githubusercontent.com/OsintMeThat/azimut/main/packaging/updates.json"
    }
  }
}
