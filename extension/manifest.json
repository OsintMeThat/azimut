{
  "manifest_version": 3,
  "name": "Azimut Capture",
  "version": "0.3.0",
  "description": "File into Azimut: screenshot the map you are looking at (coordinates from the URL), save any other page as a bookmark, fill a social composer with a thread the app prepared, or open a reverse-image engine with a picture from the case.",
  "permissions": ["activeTab", "scripting", "storage", "notifications"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://bsky.app/*",
    "https://lens.google.com/*",
    "https://www.google.com/*",
    "https://yandex.com/*",
    "https://www.bing.com/*",
    "https://tineye.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture this map into Azimut",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Open the Azimut capture popup"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "azimut-capture@osintmethat.github.io",
      "strict_min_version": "115.0",
      "update_url": "https://raw.githubusercontent.com/OsintMeThat/azimut/main/packaging/updates.json"
    }
  }
}
