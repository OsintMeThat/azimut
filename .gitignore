.calibration-profile/

# Editors / IDE
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Workspace / OS
*.code-workspace
*.log
.azimut-relaunch.json

# Misc
*.bak
*.orig

# Azimut build artifacts (frontend builds into the Python package)
src/azimut/static/

# Local tooling / assistant configs
CLAUDE.md
.claude/
AGENTS.md
.codex/
.agents/
.cheatsheet

# PyInstaller local output
dist-bin/
build-bin/

# Native binaries downloaded by the release workflow
packaging/vendor/

# Signed extension, downloaded from AMO at release cut and uploaded to the
